# Kök .env — server bu değerlere ihtiyaç duyar (client tarafında artık hiçbir gizli anahtar yok).
# Yerel geliştirmede: bu dosyayı .env olarak kopyalayıp doldurun.
# Vercel'de: aynı adlarla Project Settings → Environment Variables altına girin.

# --- Render Postgres (Dashboard → veritabanı → Connections → External Database URL) ---
DATABASE_URL=postgresql://user:password@host.frankfurt-postgres.render.com/dbname
# Veritabanı TLS: verify (varsayılan, sertifika doğrulanır) veya disable (localhost için varsayılan)
DATABASE_SSL=verify
# Özel CA kullanan sağlayıcı için PEM sertifikası (satır sonları \n olarak)
DATABASE_CA_CERT=

# --- Google OAuth (Google Cloud Console → APIs & Services → Credentials) ---
GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxxx

# --- İlk yönetici hesabı (bu e-posta ile Google girişi yapan kişi otomatik yönetici olur) ---
ADMIN_EMAIL=you@example.com

# --- İsteğe bağlı ---
# Oturum JWT'lerini imzalamak için sabit bir sır (verilmezse otomatik üretilip veritabanında saklanır)
# JWT_SECRET=

# Redirect URI'nin otomatik tespiti (req.protocol + host) yetmezse (ör. bazı proxy kurulumlarında) elle verin:
# PUBLIC_BASE_URL=https://snowflake-library-dnz.vercel.app
