# Kök .env — hem server hem client bu değerlere ihtiyaç duyar.
# Yerel geliştirmede: bu dosyayı .env olarak kopyalayıp doldurun.
# Vercel'de: aynı adlarla Project Settings → Environment Variables altına girin.

# --- Supabase (Project Settings → API) ---
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_ANON_KEY=xxxxx
SUPABASE_SERVICE_ROLE_KEY=xxxxx

# --- Supabase Postgres bağlantısı (Project Settings → Database → Connection string → Transaction pooler) ---
DATABASE_URL=postgresql://postgres.xxxxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?sslmode=require

# --- İstemci (Vite) — VITE_ önekli olanlar tarayıcıya gömülür, gizli tutmayın ---
VITE_SUPABASE_URL=https://xxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=xxxxx
